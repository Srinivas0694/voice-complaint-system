# ── Supabase Postgres ───────────────────────────────────────────
# Settings → Database → Connection string.
# DATABASE_URL uses the pooler (port 6543) — required on serverless.
# DIRECT_URL uses the direct connection (port 5432) — used by migrations only.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Supabase Storage ────────────────────────────────────────────
# Settings → API. The SERVICE ROLE key bypasses RLS — server-side only, never
# expose it to the browser or put it in a NEXT_PUBLIC_ variable.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_AUDIO_BUCKET="complaints"

# ── Speech to text ──────────────────────────────────────────────
# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-2.0-flash"
# https://console.groq.com/keys  (free fallback; optional)
GROQ_API_KEY=""

# ── Crypto ──────────────────────────────────────────────────────
# Generate each of these with:  openssl rand -hex 32
JWT_SECRET="64-hex-chars"
DEVICE_SECRET_ENC_KEY="64-hex-chars"

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
